# Строка подключения к PostgreSQL
# Формат: postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/ИМЯ_БАЗЫ?schema=public
# Локальная разработка:  postgresql://nikita@localhost:5432/devcard?schema=public
# Docker Compose:        postgresql://postgres:postgres@db:5432/devcard?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/devcard?schema=public"

# Порт, на котором поднимается приложение
PORT=3000
